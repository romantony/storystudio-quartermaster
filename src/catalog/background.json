{
  "version": "2026-07-02.1",
  "providers": {
    "replicate": { "limit": 20, "secretEnv": "REPLICATE_API_TOKEN" },
    "kie":       { "limit": 30, "floors": { "video": 15, "rest": 15 }, "secretEnv": "KIE_AI_API_KEY" },
    "google":    { "limit": 8,  "secretEnv": "GOOGLE_API_KEY" },
    "anthropic": { "limit": 8,  "secretEnv": "ANTHROPIC_API_KEY" },
    "openai":    { "limit": 8,  "secretEnv": "OPENAI_API_KEY" },
    "runpod":    { "limit": 10, "secretEnv": "RUNPOD_API_KEY",
                   "note": "Self-hosted RunPod-serverless models (Flux-TTS-S2T, qwen-image-gen/edit). Concurrency is gated per-endpoint (COUNTER#runpod:*), not by this global limit; account-wide worker cap is 10 (20 post-$200)." }
  },
  "circuit": {
    "errorThreshold": 0.5,
    "windowSeconds": 60,
    "minSamples": 5,
    "openCooldownSeconds": 30,
    "halfOpenProbes": 2
  },
  "ladders": {
    "image.basic.t2i": [
      { "provider": "runpod", "model": "flux-klein-4b", "mode": "image", "endpointId": "rnqxi6c0mlq517", "endpoint": "v2/rnqxi6c0mlq517", "counterKey": "runpod:flux-tts-s2t", "routingMode": "direct", "lane": "rest",
        "note": "T2I standardized on self-hosted Flux Klein 4B (Flux-TTS-S2T mode:image) across all project types." },
      { "provider": "replicate", "model": "black-forest-labs/flux-2-klein-9b", "routingMode": "aggregated", "lane": "rest", "fb": true }
    ],
    "image.explainer.t2i": [
      { "provider": "runpod", "model": "flux-klein-4b", "mode": "image", "endpointId": "rnqxi6c0mlq517", "endpoint": "v2/rnqxi6c0mlq517", "counterKey": "runpod:flux-tts-s2t", "routingMode": "direct", "lane": "rest",
        "note": "T2I standardized on Flux Klein 4B. NOTE: nano-banana (fb) renders in-image text better — re-promote it if explainer text rendering regresses." },
      { "provider": "kie", "model": "google/nano-banana", "endpoint": "v1/jobs/createTask", "routingMode": "aggregated", "lane": "rest", "fb": true,
        "note": "Explainer text-in-image fallback — Google nano-banana." }
    ],
    "image.basic.i2i": [
      { "provider": "replicate", "model": "black-forest-labs/flux-2-klein-9b", "routingMode": "aggregated", "lane": "rest" }
    ],
    "image.premium.t2i": [
      { "provider": "runpod", "model": "flux-klein-4b", "mode": "image", "endpointId": "rnqxi6c0mlq517", "endpoint": "v2/rnqxi6c0mlq517", "counterKey": "runpod:flux-tts-s2t", "routingMode": "direct", "lane": "rest",
        "note": "T2I standardized on self-hosted Flux Klein 4B. (Also the movie-basic image t2i via alias.)" },
      { "provider": "kie", "model": "google/nano-banana",        "endpoint": "v1/jobs/createTask", "routingMode": "aggregated", "lane": "rest", "fb": true },
      { "provider": "kie", "model": "ideogram/v3-text-to-image", "endpoint": "v1/jobs/createTask", "routingMode": "aggregated", "lane": "rest", "fb": true, "fixed": { "rendering_speed": "TURBO" } }
    ],
    "image.premium.i2i": [
      { "provider": "kie", "model": "google/nano-banana-edit", "endpoint": "v1/jobs/createTask", "routingMode": "aggregated", "lane": "rest" },
      { "provider": "kie", "model": "qwen/image-edit",         "endpoint": "v1/jobs/createTask", "routingMode": "aggregated", "lane": "rest" }
    ],

    "image.narrationBasic.t2i": [
      { "provider": "runpod", "model": "flux-klein-4b", "mode": "image", "endpointId": "rnqxi6c0mlq517", "endpoint": "v2/rnqxi6c0mlq517", "counterKey": "runpod:flux-tts-s2t", "routingMode": "direct", "lane": "rest",
        "note": "Narration Basic image T2I — self-hosted Flux Klein 4B (Flux-TTS-S2T mode:image)." },
      { "provider": "replicate", "model": "black-forest-labs/flux-2-klein-9b", "routingMode": "aggregated", "lane": "rest", "fb": true }
    ],
    "image.narrationBasic.i2i": [
      { "provider": "runpod", "model": "flux-klein-4b", "mode": "image", "endpointId": "rnqxi6c0mlq517", "endpoint": "v2/rnqxi6c0mlq517", "counterKey": "runpod:flux-tts-s2t", "routingMode": "direct", "lane": "rest",
        "note": "Narration Basic image I2I — Flux Klein 4B with reference_images (Flux-TTS-S2T mode:image)." },
      { "provider": "replicate", "model": "black-forest-labs/flux-2-klein-9b", "routingMode": "aggregated", "lane": "rest", "fb": true }
    ],
    "voice.narrationBasic.tts": [
      { "provider": "runpod", "model": "kokoro", "mode": "tts", "engine": "kokoro", "endpointId": "rnqxi6c0mlq517", "endpoint": "v2/rnqxi6c0mlq517", "counterKey": "runpod:flux-tts-s2t", "routingMode": "direct", "lane": "rest",
        "note": "Narration Basic TTS — self-hosted Kokoro-82M (Flux-TTS-S2T mode:tts engine:kokoro)." },
      { "provider": "replicate", "model": "jaaari/kokoro-82m", "routingMode": "aggregated", "lane": "rest", "fb": true }
    ],

    "image.narrationPremium.t2i": [
      { "provider": "runpod", "model": "flux-klein-4b", "mode": "image", "endpointId": "rnqxi6c0mlq517", "endpoint": "v2/rnqxi6c0mlq517", "counterKey": "runpod:flux-tts-s2t", "routingMode": "direct", "lane": "rest",
        "note": "Narration Premium image T2I — Flux Klein 4B on flux-tts-s2t. StoryStudio always sends a character reference (→ i2i on qwen-image-edit); reference-less premium frames (scene shots) land here rather than qwen-image-gen, which is held at 0 workers (fleet.ts). Re-point to qwen-image-gen + raise its workers only if a dedicated premium t2i model is needed." },
      { "provider": "kie", "model": "google/nano-banana",        "endpoint": "v1/jobs/createTask", "routingMode": "aggregated", "lane": "rest", "fb": true },
      { "provider": "kie", "model": "ideogram/v3-text-to-image", "endpoint": "v1/jobs/createTask", "routingMode": "aggregated", "lane": "rest", "fb": true, "fixed": { "rendering_speed": "TURBO" } }
    ],
    "image.narrationPremium.i2i": [
      { "provider": "runpod", "model": "qwen-image-edit", "mode": "i2i", "endpointId": "oxwx8o879qwtla", "endpoint": "v2/oxwx8o879qwtla", "counterKey": "runpod:qwen-image-edit", "routingMode": "direct", "lane": "rest",
        "note": "Narration Premium image I2I — self-hosted Qwen-Image-Edit (qwen-image-edit endpoint)." },
      { "provider": "kie", "model": "google/nano-banana-edit", "endpoint": "v1/jobs/createTask", "routingMode": "aggregated", "lane": "rest", "fb": true },
      { "provider": "kie", "model": "qwen/image-edit",         "endpoint": "v1/jobs/createTask", "routingMode": "aggregated", "lane": "rest", "fb": true }
    ],
    "voice.narrationPremium.tts": [
      { "provider": "runpod", "model": "qwen-voice-design", "mode": "tts", "engine": "qwen", "endpointId": "rnqxi6c0mlq517", "endpoint": "v2/rnqxi6c0mlq517", "counterKey": "runpod:flux-tts-s2t", "routingMode": "direct", "lane": "rest",
        "note": "Narration Premium TTS — self-hosted Qwen Voice Design (Flux-TTS-S2T mode:tts engine:qwen)." },
      { "provider": "google", "model": "gemini-3.1-flash-tts-preview", "routingMode": "direct", "lane": "rest", "fb": true }
    ],

    "bgm.narration": [
      { "provider": "runpod", "model": "ace-step", "mode": "bgm", "endpointId": "6apg6j7suzuezw", "endpoint": "v2/6apg6j7suzuezw", "counterKey": "runpod:bgm-s2t", "routingMode": "direct", "lane": "rest",
        "note": "Narration BGM (both tiers) — self-hosted ACE-Step on the dedicated bgm-s2t endpoint (6apg6j7suzuezw, ENDPOINT_ROLE=audio), split off flux-tts-s2t so once-per-project BGM never steals workers from the per-frame pipeline." },
      { "provider": "kie", "model": "suno", "modelId": "V4_5", "endpoint": "v1/generate", "routingMode": "aggregated", "lane": "rest", "fb": true }
    ],
    "bgm.narrationBasic": { "aliasOf": "bgm.narration" },
    "bgm.narrationPremium": { "aliasOf": "bgm.narration" },
    "srt.narration": [
      { "provider": "runpod", "model": "whisper-large-v3-turbo", "mode": "transcribe", "endpointId": "6apg6j7suzuezw", "endpoint": "v2/6apg6j7suzuezw", "counterKey": "runpod:bgm-s2t", "routingMode": "direct", "lane": "rest",
        "note": "Narration SRT (both tiers) — self-hosted Whisper large-v3-turbo on the dedicated bgm-s2t endpoint (6apg6j7suzuezw, ENDPOINT_ROLE=audio), split off flux-tts-s2t." },
      { "provider": "replicate", "model": "openai/whisper", "routingMode": "aggregated", "lane": "rest", "fb": true }
    ],
    "video.narrationBasic.animate": [
      { "provider": "runpod", "model": "flux-animate", "mode": "animate", "endpointId": "rnqxi6c0mlq517", "endpoint": "v2/rnqxi6c0mlq517", "counterKey": "runpod:flux-tts-s2t", "routingMode": "direct", "lane": "rest",
        "fixed": { "effect": "ken_burns" },
        "note": "Narration Basic animation — Flux-TTS-S2T animate (smooth Ken Burns), replaces the jittery local i2v render." }
    ],
    "video.narrationBasic.merge": [
      { "provider": "runpod", "model": "flux-merge", "mode": "merge", "endpointId": "rnqxi6c0mlq517", "endpoint": "v2/rnqxi6c0mlq517", "counterKey": "runpod:flux-tts-s2t", "routingMode": "direct", "lane": "rest",
        "note": "Narration Basic per-frame audio merge — Flux-TTS-S2T merge (animated video + TTS voice)." }
    ],
    "video.narrationBasic.pipeline": [
      { "provider": "runpod", "model": "flux-pipeline", "mode": "pipeline", "endpointId": "rnqxi6c0mlq517", "endpoint": "v2/rnqxi6c0mlq517", "counterKey": "runpod:flux-tts-s2t", "routingMode": "direct", "lane": "rest",
        "fixed": { "effect": "ken_burns" },
        "note": "Narration Basic one-shot per frame — Flux-TTS-S2T pipeline mode (image -> Kokoro TTS -> animate -> merge in one call, models resident in VRAM). Replaces 4 separate QM jobs/frame. caption:false + no bgm (SRT + BGM are project-level). Internal-only: no external one-shot equivalent, and basic is 100% flux-dependent anyway (animate/merge are flux-only), so no DR is lost." }
    ],
    "video.narrationPremium.merge": { "aliasOf": "video.narrationBasic.merge" },

    "video.basic": [
      { "provider": "consumer", "model": "stock-footage",    "routingMode": "stock",  "lane": "none", "note": "Documentary Basic: free Pexels/Pixabay footage" },
      { "provider": "consumer", "model": "ken-burns",        "routingMode": "render", "lane": "none", "fb": true },
      { "provider": "consumer", "model": "basic-animation",  "routingMode": "render", "lane": "none", "fb": true }
    ],
    "video.premium.i2v": [
      { "provider": "runpod", "model": "wan-2.2-i2v", "mode": "i2v", "endpointId": "nd7wloyvj09xwy", "endpoint": "v2/nd7wloyvj09xwy", "counterKey": "runpod:wan2-i2v", "routingMode": "direct", "lane": "video",
        "fixed": { "resolution": "480p" },
        "note": "Premium video I2V — self-hosted Wan 2.2 I2V-A14B 4-step Lightning (RunPod nd7wloyvj09xwy). Aspect ratio inherits from the input image." },
      { "provider": "replicate", "model": "wan-video/wan-2.2-i2v-fast", "routingMode": "aggregated", "lane": "video", "fb": true }
    ],
    "video.narrationPremium.i2v": { "aliasOf": "video.premium.i2v" },
    "movie.basic.image.t2i":  { "aliasOf": "image.premium.t2i" },
    "movie.basic.image.i2i":  { "aliasOf": "image.premium.i2i" },
    "movie.basic.video.i2v": [
      { "provider": "kie",      "model": "bytedance/seedance-1.5-pro", "endpoint": "v1/jobs/createTask", "routingMode": "aggregated", "lane": "video" },
      { "provider": "replicate","model": "bytedance/seedance-1.5-pro",                                   "routingMode": "aggregated", "lane": "video", "fb": true }
    ],
    "movie.premium.image.t2i": [
      { "provider": "runpod", "model": "flux-klein-4b", "mode": "image", "endpointId": "rnqxi6c0mlq517", "endpoint": "v2/rnqxi6c0mlq517", "counterKey": "runpod:flux-tts-s2t", "routingMode": "direct", "lane": "rest",
        "note": "T2I standardized on self-hosted Flux Klein 4B. Was nano-banana-2 (higher quality, now DR fallback) — re-promote if movie-premium image quality regresses." },
      { "provider": "kie", "model": "nano-banana-2", "endpoint": "v1/jobs/createTask", "routingMode": "aggregated", "lane": "rest", "fb": true }
    ],
    "movie.premium.image.i2i": { "aliasOf": "movie.premium.image.t2i" },
    "movie.premium.video.i2v": [
      { "provider": "kie",      "model": "bytedance/seedance-2-fast",  "endpoint": "v1/jobs/createTask", "routingMode": "aggregated", "lane": "video" },
      { "provider": "replicate","model": "bytedance/seedance-2.0-fast",                                  "routingMode": "aggregated", "lane": "video", "fb": true }
    ],
    "voice.basic.tts": [
      { "provider": "replicate", "model": "jaaari/kokoro-82m", "routingMode": "aggregated", "lane": "rest" }
    ],
    "voice.premium.tts": [
      { "provider": "google", "model": "gemini-3.1-flash-tts-preview", "routingMode": "direct", "lane": "rest" }
    ],
    "sfx": [
      { "provider": "replicate", "model": "sepal/audiogen", "routingMode": "aggregated", "lane": "rest" }
    ],
    "bgm.basic": { "aliasOf": "bgm.narration" },
    "bgm.premium": [
      { "provider": "kie", "model": "suno", "modelId": "V4_5", "endpoint": "v1/generate", "routingMode": "aggregated", "lane": "rest" }
    ],
    "llm": [
      { "provider": "anthropic", "model": "claude", "routingMode": "direct", "lane": "rest" },
      { "provider": "google",    "model": "gemini", "routingMode": "direct", "lane": "rest", "fb": true },
      { "provider": "openai",    "model": "gpt",    "routingMode": "direct", "lane": "rest", "fb": true }
    ]
  }
}
