# ── required (no defaults) ───────────────────────────────────────────────────
DATABASE_URL=postgres://qm:qm@localhost:5432/qm_orchestrator
ORCH_INGEST_TOKEN=dev-ingest-token
ORCH_WEBHOOK_SECRET=dev-webhook-secret
# Real deployed hostname RunPod webhooks are addressed to — spec §11: "hostname
# stability is now a correctness requirement." Never localhost outside dev.
ORCH_PUBLIC_BASE_URL=https://orchestrator.ai-storystudio.com

# ── runtime ─────────────────────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=info
ORCH_PORT=8080

# ── datastore ───────────────────────────────────────────────────────────────
PG_POOL_MAX=20
PG_STATEMENT_TIMEOUT_MS=15000

# ── RunPod (optional until M2 — no call is made before then) ─────────────────
# RUNPOD_API_KEY=
RUNPOD_API_BASE=https://api.runpod.ai/v2
RUNPOD_REST_BASE=https://rest.runpod.io/v1
RUNPOD_MAX_RETRIES=5
RUNPOD_TIMEOUT_MS=30000

# ── fleet / window (impl plan §17) ──────────────────────────────────────────
ORCH_FLEET_LIVE=false
ORCH_WINDOW_CRON=0 0,6,12,18 * * *
ORCH_WORKERS_HEAD=25
ORCH_WORKERS_TAIL=10
QM_LIVE_RESERVE_WORKERS=8
RUNPOD_ACCOUNT_CAP=40
ORCH_WARM_TIMEOUT_MS=480000
ORCH_DRAIN_TIMEOUT_MS=300000
ORCH_RECONCILE_INTERVAL_MS=60000
ORCH_MAX_ATTEMPTS=2
ORCH_QUALITY_GATES=full
WORKER_RATE_USD_S=0.00021

# Prompt harness (docs/qm-orchestrator-prompt-harness-implementation-plan.md).
# Per-request rollout switch is options.promptHarness ('off'|'lint'|'enforce',
# default 'lint'), not an env var — this only bounds concurrency.
ORCH_HARNESS_TOOL_CONCURRENCY=8

# Read-only diagnostic assistant (src/diagnostics/diagnose.ts). Sonnet 5 is
# reached through REPLICATE, not the Anthropic API — changed 2026-09-19 after
# the direct account ran out of credit. It uses REPLICATE_API_TOKEN above;
# unset that and the feature is simply off.
ORCH_DIAGNOSTICS_MODEL=anthropic/claude-sonnet-5
# low (default) disables thinking: this is a short structured-JSON judgement on
# an alerting path, not a reasoning task. low|medium|high|xhigh|max.
ORCH_DIAGNOSTICS_EFFORT=low

# §6.7 result callback — optional HMAC key for X-QM-Signature (unset = unsigned)
# ORCH_CALLBACK_SECRET=
ORCH_CALLBACK_MAX_ATTEMPTS=8
ORCH_CALLBACK_BASE_DELAY_MS=1000
ORCH_CALLBACK_MAX_DELAY_MS=300000
ORCH_CALLBACK_TIMEOUT_MS=15000

# ── asset pipeline (src/assets/README.md, migration 013) ────────────────────
# 'cohort' (default) = today's window/step-graph model, unchanged.
# 'assets' = per-asset generator agents + the project compiler. Flipping this
# is the whole rollout switch; nothing else changes.
ORCH_PIPELINE_MODE=cohort
ORCH_ASSET_TICK_MS=5000
ORCH_COMPILER_TICK_MS=30000
ORCH_ASSET_DISPATCH_BATCH_SIZE=4
ORCH_ASSET_RECONCILE_AFTER_MS=60000
# The tail is ONE postprod-lite call per project (mode: 'postprod'), dispatched
# by the postprod-lite agent under that endpoint's pod limit — so the pod count
# is also the number of projects that assemble at once. R2 credentials below
# let the compiler write the manifest as a FILE; without them it falls back to
# an inline manifest and refuses one over 128KB.

# Quality gating for the gated generation kinds (src/assets/quality.ts).
# 'full' (default): free structural checks on EVERY asset (ffmpeg + maths — no
# model, no GPU), plus the Replicate VLM semantic score on a SAMPLE of them.
# 'local': structural only. What 'full' degrades to with no REPLICATE_API_TOKEN.
# 'off': no gate — a completed asset hands off immediately.
ORCH_ASSET_QA=full
ORCH_ASSET_QA_BATCH_SIZE=8
ORCH_ASSET_QA_TICK_MS=10000
# What fraction of assets get the PAID VLM check. The local tier always runs at
# 100%; this is only the Replicate call. 0.3 today, 0.1 once the prompt harness
# describes movement and direction well enough. 0 disables the VLM tier alone.
# Explainer/educational products are never sampled — Remotion renders them.
ORCH_ASSET_QA_SAMPLE_RATE=0.3
# Multipliers on the rate: a shot that asks for movement and direction is where
# a VLM earns its keep. At 0.3 these give ~75% and ~12%.
ORCH_ASSET_QA_MOTION_WEIGHT=2.5
ORCH_ASSET_QA_STATIC_WEIGHT=0.4
