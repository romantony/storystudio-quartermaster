# ── required (no defaults) ───────────────────────────────────────────────────
DATABASE_URL=postgres://qm:qm@localhost:5432/qm_orchestrator
ORCH_INGEST_TOKEN=dev-ingest-token
ORCH_WEBHOOK_SECRET=dev-webhook-secret

# ── runtime ─────────────────────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=info
ORCH_PORT=8080

# ── datastore ───────────────────────────────────────────────────────────────
PG_POOL_MAX=20
PG_STATEMENT_TIMEOUT_MS=15000

# ── RunPod (optional until M2 — no call is made before then) ─────────────────
# RUNPOD_API_KEY=
RUNPOD_API_BASE=https://api.runpod.ai/v2
RUNPOD_REST_BASE=https://rest.runpod.io/v1
RUNPOD_MAX_RETRIES=5
RUNPOD_TIMEOUT_MS=30000

# ── fleet / window (impl plan §17) ──────────────────────────────────────────
ORCH_FLEET_LIVE=false
ORCH_WINDOW_CRON=0 0,6,12,18 * * *
ORCH_WORKERS_HEAD=25
ORCH_WORKERS_TAIL=10
QM_LIVE_RESERVE_WORKERS=8
RUNPOD_ACCOUNT_CAP=40
ORCH_WARM_TIMEOUT_MS=480000
ORCH_DRAIN_TIMEOUT_MS=300000
ORCH_RECONCILE_INTERVAL_MS=60000
ORCH_MAX_ATTEMPTS=2
ORCH_QUALITY_GATES=full
WORKER_RATE_USD_S=0.00021
