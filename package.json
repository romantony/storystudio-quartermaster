{
  "name": "quartermaster",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "admin",
    "sdk/typescript",
    "infra",
    "orchestrator"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "jest",
    "cdk": "cd infra && npx cdk",
    "synth": "cd infra && npx cdk synth",
    "deploy": "cd infra && npx cdk deploy --all"
  },
  "dependencies": {
    "@aws-sdk/client-cloudwatch": "^3.600.0",
    "@aws-sdk/client-dynamodb": "^3.600.0",
    "@aws-sdk/client-lambda": "^3.600.0",
    "@aws-sdk/client-s3": "^3.1095.0",
    "@aws-sdk/client-secrets-manager": "^3.600.0",
    "@aws-sdk/client-sfn": "^3.600.0",
    "@aws-sdk/lib-dynamodb": "^3.600.0",
    "@aws-sdk/util-dynamodb": "^3.600.0",
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@remotion/lambda-client": "4.0.443",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.140",
    "@types/bcryptjs": "^2.4.6",
    "@types/jest": "^29.5.12",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.14.0",
    "esbuild": "^0.21.5",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.5",
    "typescript": "^5.5.2"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "**/__tests__/**/*.test.ts"
    ],
    "moduleNameMapper": {
      "^@qm/(.*)$": "<rootDir>/src/$1"
    }
  }
}
